# Copia este archivo como .env y ajusta. El .env NO se sube al repo.

# ---- Proveedor de IA ----
# Ollama local (no necesita nada aquí). Modelos configurables:
# OLLAMA_CHAT_MODEL=qwen2.5:3b
# OLLAMA_EMBEDDING_MODEL=bge-m3

# ---- Historial de conversaciones (DynamoDB Local) ----
# HISTORIAL_ENABLED=false          # para no guardar el historial

# ---- BD del monolito (solo lectura) ----
# Por defecto: MySQL de PRUEBA del docker-compose (estructura real + datos ficticios).
# Para apagar la lectura del monolito y usar solo el FAQ:
# MONOLITO_ENABLED=false

# BD REAL: solo cambiar estas tres líneas, el código no se toca.
# (Antes, crear el usuario con db/99-usuario-chatbot.sql en la BD real.)
# MONOLITO_DB_URL=jdbc:mysql://HOST:PUERTO/NOMBRE_BD?allowPublicKeyRetrieval=true
# MONOLITO_DB_USERNAME=chatbot_ro
# MONOLITO_DB_PASSWORD=la_contraseña_real

# ---- Rate limit ----
RATE_LIMIT_POR_MINUTO=10
